# Facultatif pour le bootstrap : l'application fonctionne sans ces valeurs.
# Copier dans .env.local pour une future connexion au Supabase LOCAL.
# VITE_* est public et inclus dans le JavaScript envoyé au navigateur.
# URL locale du projet : http://127.0.0.1:55321
VITE_SUPABASE_URL=
# Clé publishable locale fournie par la CLI (préfixe sb_publishable_).
# Ne jamais mettre de clé privilégiée, mot de passe ou token ici.
VITE_SUPABASE_PUBLISHABLE_KEY=
